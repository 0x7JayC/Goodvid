# ── Supabase ───────────────────────────────────────────────────────────────────
# https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OpenRouter ─────────────────────────────────────────────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Model A — Vision analysis (reads images → structured text)
# Must support image inputs. Recommended: google/gemini-flash-1.5 (fast + cheap)
# Alternatives: google/gemini-2.0-flash-001 | anthropic/claude-sonnet-4-5
OPENROUTER_VISION_MODEL=google/gemini-flash-1.5

# Model B — Director (text-only, receives analysis → shot sheet JSON)
# Kimi K2.6 is text-only and very affordable
OPENROUTER_TEXT_MODEL=moonshotai/kimi-k2.6

# Model C — Storyboard image generation (full production bible as one image)
OPENROUTER_IMAGE_MODEL=openai/gpt-5.4-image-2

# Video generation — Seedance 2.0 for 15-second films
OPENROUTER_VIDEO_MODEL=bytedance/seedance-2.0

# ── App URL ────────────────────────────────────────────────────────────────────
# Local: http://localhost:3000
# Production: your Vercel URL, e.g. https://goodvid.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
